{
  "description": "Desktop app on the developer laptop, against the user's real files. Expectations reflect files verified to exist on this machine on 30 Oct 2026.",
  "timeoutSec": 180,
  "cases": [
    {
      "id": "general-react",
      "query": "What is React?",
      "expect": {
        "any": [
          "javascript",
          "library",
          "user interface"
        ]
      }
    },
    {
      "id": "general-capital",
      "query": "What is the capital of France?",
      "expect": {
        "any": [
          "paris"
        ]
      }
    },
    {
      "id": "find-resume-typo",
      "query": "give me my resme",
      "expect": {
        "any": [
          "resume",
          "\\bcv\\b"
        ],
        "minFiles": 1,
        "maxSeconds": 30
      }
    },
    {
      "id": "find-aadhaar",
      "query": "give me my adhar",
      "expect": {
        "any": [
          "adhar",
          "aadhaar",
          "aadhar"
        ],
        "minFiles": 1,
        "maxSeconds": 30
      }
    },
    {
      "id": "count-pdf",
      "query": "How many PDF files do I have?",
      "expect": {
        "all": [
          "\\d+",
          "pdf"
        ],
        "maxSeconds": 30
      }
    },
    {
      "id": "battery",
      "query": "What is my battery level?",
      "expect": {
        "all": [
          "\\d{1,3}\\s?%"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "storage",
      "query": "How much storage is left?",
      "expect": {
        "all": [
          "free"
        ],
        "maxSeconds": 15,
        "none": [
          "\"drive\"",
          "volumeName",
          "\\{"
        ]
      }
    },
    {
      "id": "specs",
      "query": "What are my laptop specs?",
      "expect": {
        "all": [
          "cpu",
          "memory"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "read-resume",
      "query": "Read my resume",
      "expect": {
        "none": [
          "components, hooks",
          "could not complete"
        ]
      }
    },
    {
      "id": "open-app",
      "query": "open calculator",
      "expect": {
        "any": [
          "calculator"
        ]
      }
    },
    {
      "id": "missing-doc",
      "query": "find my passport",
      "expect": {
        "any": [
          "couldn't find",
          "could not find"
        ],
        "maxSeconds": 30,
        "none": [
          "located",
          "found .*aadhaar",
          "found .*passport"
        ]
      }
    }
  ]
}
