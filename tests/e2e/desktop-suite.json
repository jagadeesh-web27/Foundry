{
  "description": "Desktop app on the developer laptop, against the user's real files. Expectations reflect files verified to exist on this machine on 30 Oct 2026.",
  "timeoutSec": 180,
  "cases": [
    {
      "id": "general-react",
      "query": "What is React?",
      "expect": {
        "any": [
          "javascript",
          "library",
          "user interface"
        ]
      }
    },
    {
      "id": "general-capital",
      "query": "What is the capital of France?",
      "expect": {
        "any": [
          "paris"
        ]
      }
    },
    {
      "id": "find-resume-typo",
      "query": "give me my resme",
      "expect": {
        "any": [
          "resume",
          "\\bcv\\b"
        ],
        "minFiles": 1,
        "maxSeconds": 30
      }
    },
    {
      "id": "find-aadhaar",
      "query": "give me my adhar",
      "expect": {
        "any": [
          "adhar",
          "aadhaar",
          "aadhar"
        ],
        "minFiles": 1,
        "maxSeconds": 30
      }
    },
    {
      "id": "count-pdf",
      "query": "How many PDF files do I have?",
      "expect": {
        "all": [
          "\\d+",
          "pdf"
        ],
        "maxSeconds": 30
      }
    },
    {
      "id": "battery",
      "query": "What is my battery level?",
      "expect": {
        "all": [
          "\\d{1,3}\\s?%"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "storage",
      "query": "How much storage is left?",
      "expect": {
        "all": [
          "free"
        ],
        "maxSeconds": 15,
        "none": [
          "\"drive\"",
          "volumeName",
          "\\{"
        ]
      }
    },
    {
      "id": "specs",
      "query": "What are my laptop specs?",
      "expect": {
        "all": [
          "cpu",
          "memory"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "read-resume",
      "query": "Read my resume",
      "expect": {
        "none": [
          "components, hooks",
          "could not complete",
          "could not extract",
          "none of the top"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "open-app",
      "query": "open calculator",
      "expect": {
        "any": [
          "calculator"
        ]
      }
    },
    {
      "id": "missing-doc",
      "query": "find my passport",
      "expect": {
        "any": [
          "couldn't find",
          "could not find"
        ],
        "maxSeconds": 30,
        "none": [
          "located",
          "found .*aadhaar",
          "found .*passport"
        ]
      }
    },
    {
      "id": "clock-time-now",
      "query": "what is the time now",
      "expect": {
        "all": [
          "{{time}}"
        ],
        "none": [
          "don't know",
          "cannot",
          "can't",
          "as an ai"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-date-today",
      "query": "what is the date today",
      "expect": {
        "all": [
          "{{weekday}}",
          "{{year}}"
        ],
        "any": [
          "{{day}},? {{month}}",
          "{{month}} {{day}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-which-day",
      "query": "which day is today",
      "expect": {
        "all": [
          "{{weekday}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-tomorrow",
      "query": "what is tomorrow's date",
      "expect": {
        "all": [
          "{{tomorrowWeekday}}"
        ],
        "any": [
          "{{tomorrowDay}},? {{tomorrowMonth}}",
          "{{tomorrowMonth}} {{tomorrowDay}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-date-and-time",
      "query": "Hey Foundry, what's the date and time right now?",
      "expect": {
        "all": [
          "{{time}}",
          "{{weekday}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-city",
      "query": "what time is it in London",
      "expect": {
        "all": [
          "London",
          "\\d{1,2}:\\d{2}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-days-until",
      "query": "how many days until christmas",
      "expect": {
        "all": [
          "\\d+ days? until Christmas",
          "25 December|December 25"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "general-uses-today",
      "query": "How old is a person born in 2000 this year?",
      "expect": {
        "any": [
          "\\b26\\b",
          "\\b25 or 26\\b",
          "\\b25\\b"
        ],
        "none": [
          "2023",
          "2024"
        ]
      }
    }
  ]
}
