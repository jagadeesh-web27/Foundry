{
  "description": "Physical Android phone. Files come from the FoundryTestData fixtures provisioned by tests/android/android-test-utils.ts (test-resume.pdf, test-document.pdf, test-document.docx, test-spreadsheet.xlsx, test-notes.txt, test-image.jpg). test-today-note.txt is created on the day of the run (see docs/TESTING.md) to check date filters.",
  "timeoutSec": 240,
  "cases": [
    {
      "id": "general-react",
      "query": "What is React?",
      "expect": {
        "any": [
          "javascript",
          "library",
          "user interface"
        ]
      }
    },
    {
      "id": "general-capital",
      "query": "What is the capital of France?",
      "expect": {
        "any": [
          "paris"
        ]
      }
    },
    {
      "id": "find-resume",
      "query": "Find my resume",
      "expect": {
        "all": [
          "test-resume"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "find-resume-typo",
      "query": "give me my resme",
      "expect": {
        "all": [
          "test-resume"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "count-pdf",
      "query": "How many PDF files do I have?",
      "expect": {
        "all": [
          "you have (?:[1-9]\\d*) pdf files"
        ]
      }
    },
    {
      "id": "find-word",
      "query": "Find my Word files",
      "expect": {
        "all": [
          "test-document"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "find-excel",
      "query": "Find my Excel files",
      "expect": {
        "all": [
          "test-spreadsheet"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "read-resume",
      "query": "Read my resume",
      "expect": {
        "any": [
          "PHYSICAL_RESUME_MARKER",
          "jagadeesh",
          "developer",
          "software"
        ],
        "none": [
          "components, hooks",
          "could not complete",
          "none of the top"
        ]
      }
    },
    {
      "id": "battery",
      "query": "What is my battery level?",
      "expect": {
        "all": [
          "\\d{1,3}\\s?%"
        ]
      }
    },
    {
      "id": "storage",
      "query": "How much storage is left?",
      "expect": {
        "all": [
          "free"
        ],
        "none": [
          "0 B total",
          "\"drive\"",
          "volumeName",
          "\\{"
        ]
      }
    },
    {
      "id": "missing-doc",
      "query": "find my passport",
      "expect": {
        "any": [
          "couldn't find",
          "could not find"
        ],
        "none": [
          "located",
          "found .*aadhaar",
          "found .*passport"
        ]
      }
    },
    {
      "id": "added-today",
      "query": "show files I added today",
      "expect": {
        "all": [
          "test-today-note"
        ],
        "none": [
          "test-resume",
          "test-document"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "pdfs-this-week",
      "query": "how many pdfs did I download this week",
      "expect": {
        "all": [
          "pdf files added this week"
        ]
      }
    },
    {
      "id": "open-calculator",
      "query": "open calculator",
      "expect": {
        "all": [
          "calculator",
          "Confirm"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "open-whatapp",
      "query": "open whatapp",
      "expect": {
        "all": [
          "whatsapp",
          "Confirm"
        ],
        "none": [
          "not installed"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "open-chorme",
      "query": "open chorme",
      "expect": {
        "all": [
          "chrome",
          "Confirm"
        ],
        "none": [
          "not installed"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "open-missing-app",
      "query": "open photoshop",
      "expect": {
        "any": [
          "not installed",
          "could not be found"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "open-spotify",
      "query": "open spotify",
      "expect": {
        "all": [
          "spotify",
          "Confirm"
        ],
        "maxSeconds": 15
      }
    },
    {
      "id": "clock-time-now",
      "query": "what is the time now",
      "expect": {
        "all": [
          "{{time}}"
        ],
        "none": [
          "don't know",
          "cannot",
          "can't",
          "as an ai"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-date-today",
      "query": "what is the date today",
      "expect": {
        "all": [
          "{{weekday}}",
          "{{year}}"
        ],
        "any": [
          "{{day}},? {{month}}",
          "{{month}} {{day}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-which-day",
      "query": "which day is today",
      "expect": {
        "all": [
          "{{weekday}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-tomorrow",
      "query": "what is tomorrow's date",
      "expect": {
        "all": [
          "{{tomorrowWeekday}}"
        ],
        "any": [
          "{{tomorrowDay}},? {{tomorrowMonth}}",
          "{{tomorrowMonth}} {{tomorrowDay}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-date-and-time",
      "query": "Hey Foundry, what's the date and time right now?",
      "expect": {
        "all": [
          "{{time}}",
          "{{weekday}}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-city",
      "query": "what time is it in London",
      "expect": {
        "all": [
          "London",
          "\\d{1,2}:\\d{2}"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "clock-days-until",
      "query": "how many days until christmas",
      "expect": {
        "all": [
          "\\d+ days? until Christmas",
          "25 December|December 25"
        ],
        "maxSeconds": 8
      }
    },
    {
      "id": "general-uses-today",
      "query": "How old is a person born in 2000 this year?",
      "expect": {
        "all": [
          "2026"
        ],
        "none": [
          "2023",
          "2024",
          "2025"
        ]
      }
    }
  ]
}
