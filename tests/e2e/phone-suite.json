{
  "description": "Physical Android phone. Files come from the FoundryTestData fixtures provisioned by tests/android/android-test-utils.ts (test-resume.pdf, test-document.pdf, test-document.docx, test-spreadsheet.xlsx, test-notes.txt, test-image.jpg).",
  "timeoutSec": 240,
  "cases": [
    {
      "id": "general-react",
      "query": "What is React?",
      "expect": {
        "any": [
          "javascript",
          "library",
          "user interface"
        ]
      }
    },
    {
      "id": "general-capital",
      "query": "What is the capital of France?",
      "expect": {
        "any": [
          "paris"
        ]
      }
    },
    {
      "id": "find-resume",
      "query": "Find my resume",
      "expect": {
        "all": [
          "test-resume"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "find-resume-typo",
      "query": "give me my resme",
      "expect": {
        "all": [
          "test-resume"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "count-pdf",
      "query": "How many PDF files do I have?",
      "expect": {
        "all": [
          "\\b2\\b"
        ]
      }
    },
    {
      "id": "find-word",
      "query": "Find my Word files",
      "expect": {
        "all": [
          "test-document"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "find-excel",
      "query": "Find my Excel files",
      "expect": {
        "all": [
          "test-spreadsheet"
        ],
        "minFiles": 1
      }
    },
    {
      "id": "read-resume",
      "query": "Read my resume",
      "expect": {
        "any": [
          "PHYSICAL_RESUME_MARKER",
          "Wireless Android Tester"
        ],
        "none": [
          "components, hooks"
        ]
      }
    },
    {
      "id": "battery",
      "query": "What is my battery level?",
      "expect": {
        "all": [
          "\\d{1,3}\\s?%"
        ]
      }
    },
    {
      "id": "storage",
      "query": "How much storage is left?",
      "expect": {
        "any": [
          "GB",
          "free",
          "storage"
        ],
        "none": [
          "\"drive\"",
          "volumeName",
          "\\{"
        ]
      }
    },
    {
      "id": "missing-doc",
      "query": "Find my aadhaar card",
      "expect": {
        "any": [
          "couldn't find",
          "could not find",
          "no matching",
          "not find",
          "didn't find"
        ],
        "none": [
          "1800",
          "aadhaar\\.gov",
          "uidai",
          "located",
          "found .*aadhaar",
          "found .*passport"
        ]
      }
    }
  ]
}
