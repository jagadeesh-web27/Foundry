# Foundry OAuth Client Configurations
# End users run completely locally; developers provide OAuth Client IDs.

# Google OAuth 2.0 Client ID (Type: Desktop app or Web application)
# Authorized redirect URI (if Web application): http://localhost:1420/oauth/callback
VITE_GOOGLE_CLIENT_ID=

# Microsoft Azure OAuth Client ID (Optional override)
# VITE_MICROSOFT_CLIENT_ID=a68ef3be-dc9c-4c40-8438-e6d24f74d008

# Slack App Client ID (Optional override)
# VITE_SLACK_CLIENT_ID=
